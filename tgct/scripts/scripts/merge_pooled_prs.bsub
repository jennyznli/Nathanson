#!/bin/bash
# Merge the 4 cohorts' common-SNP bfiles into one pooled bfile, then compute
# frequency once on the pooled sample (needed for makeScoreFile.R and for
# running --score a single time across everyone).
set -euo pipefail

module load plink/1.9-20210416
module load R/4.5

WDIR="/home/jennyzli/TGCT_PRS_jenny2"
OUT="$WDIR/pooled/tgct_prs_z"
OUT2="$WDIR/pooled/tgct_prs_effect"
mkdir -p "$WDIR/pooled"

BFILES=(
  "$WDIR/replication/rep_common"
  "$WDIR/gencove/gencove_common"
  "$WDIR/pmbb4/pmbb4_common"
)

first="${BFILES[0]}"
merge_list="$WDIR/pooled/merge_list.txt"
> "$merge_list"
for f in "${BFILES[@]:1}"; do
  echo "${f}.bed ${f}.bim ${f}.fam" >> "$merge_list"
done

plink --bfile "$first" --merge-list "$merge_list" --make-bed --allow-no-sex --out "$OUT"

plink --bfile "$OUT" --freq --out "$OUT"

# z score version 
score_file="$WDIR/gwas2021-hits-z.tsv"
plink --bfile "$OUT" \
      --score "$score_file" 1 2 3 header sum \
      --out "${OUT}"

# effect size version 
score_file="$WDIR/gwas2021-hits-effect.tsv"
plink --bfile "$OUT" \
      --score "$score_file" 1 2 3 header sum \
      --out "${OUT2}"


